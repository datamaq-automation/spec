# ==============================================================================
# Configuración de Entorno (.env.example)
# Copia este archivo a '.env' y completa con los valores reales de tu entorno.
# NUNCA commitees el archivo '.env' a tu repositorio de control de versiones.
# ==============================================================================

# Entorno y Depuración
ENVIRONMENT=development                # development | staging | production
DEBUG=true                             # true | false
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Configuración de la Aplicación y API
PROJECT_NAME="FastAPI Clean Architecture"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
ALLOWED_HOSTS=["*"]                    # JSON array con los hosts o dominios permitidos

# Seguridad y Autenticación
SECRET_KEY="change_this_to_a_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de Datos & Persistencia (SQLAlchemy / Async Engine)
# Ejemplos:
# SQLite (Local/Testing):  sqlite+aiosqlite:///./app.db
# PostgreSQL:              postgresql+asyncpg://user:password@localhost:5432/dbname
# MySQL / MariaDB:         mysql+aiomysql://user:password@localhost:3306/dbname
DATABASE_URL="sqlite+aiosqlite:///./app.db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Mensajería / Broker (Opcional - MQTT, Kafka, RabbitMQ, Redis)
BROKER_URL="mqtt://localhost:1883"
BROKER_CLIENT_ID="fastapi-backend"
REDIS_URL="redis://localhost:6379/0"

# Integraciones Externas & Notificaciones (Opcional)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@example.com"
SMTP_PASSWORD="secret_password"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
